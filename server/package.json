{
  "name": "fps-multiplayer-server",
  "version": "1.0.0",
  "private": true,
  "description": "Multiplayer Game Server for 3D FPS using Colyseus",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm --prefix ../shared run build && (cd ../client && NODE_ENV=development npm install && npm run build) && tsc",
    "build:server-only": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.42",
    "@colyseus/schema": "^4.0.31",
    "@colyseus/ws-transport": "^0.17.13",
    "@fps/shared": "file:../shared",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "colyseus": "^0.17.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
